{"file":"index-Cb48Nr25.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA4EA,UAAM,EAAE,KAAA,IAAS,YAAY,cAAc;AACtB,0BAAA;AAErB,UAAM,OAAO,IAAI,EAAE;AACnB,UAAM,gBAAgB,IAAY,gBAAgB,CAAC,CAAC;AACpD,UAAM,YAAY,IAAI,EAAE;AACxB,UAAM,aAAa,IAAI,KAAK;;AAjF1BA,wBAAA,OAAA,CAgEWC,WAAA;+cAhDQC,MAAA,IAAA,CAAI,CAAA,yFAAAC,eAAA,CAAA,EAAA,kBAMeD,MAAA,SAAA,EAAA,GAAS,kLAAA,CAAA,CAAA,IAAA;AAG9B,YAAAA,MAAA,SAAA,GAAS;0EAAyCA,MAAA,SAAA,CAAS,CAAA,MAAA;AAAA,QAAA,OAAA;;;;AAQhDE,sBAAAF,MAAA,eAAA,GAAA,CAAT,UAAK;AAIU,iBAAA,kBAAAG,eAAA,EAAA,YAAAH,MAAA,SAAA,EAAU,KAAK,GAAA,CAAA,YAC7BC,eAAA,CAAAD,MAAA,aAAA,MAAkB,QAAK,mCAAA,mBAAA,yFAAA,CAAA,CAAA,IAAA;AAElB,cAAAA,MAAA,aAAA,MAAkB,OAAK;;cAAG,MAAM;AAAA,cAAI,OAAM;AAAA,YAAA,GAAA,MAAA,OAAA,CAAA;AAAA;;;;;AAe9C,eAAA,yNAAAI,sBAAAJ,MAAA,UAAA,CAAU,IAAA,cAAA,EAAA,2KAAA;AAGN,YAAAA,MAAA,UAAA,GAAU;;YAAG,MAAM;AAAA,YAAI,OAAM;AAAA,UAAA,GAAA,MAAA,OAAA,CAAA;AAAA;;;AACzC,eAAA,IAAAK,eAAAL,MAAA,UAAA,IAAU,iBAAA,SAAA,CAAA,6BAAA;AAAA,MAAA,GAAA,QAAA,OAAA,OAAA;AAAA;;;;;;;;;;;;;;ACYzB,UAAM,EAAE,MAAM,QAAA,IAAY,YAAY,cAAc;AACpD,UAAM,iBAAiB,IAAI,KAAK;AAEhC,UAAM,QAAQ,SAAS,MAAM,KAAK,OAAO,QAAQ,OAAO,WAAW,KAAK,GAAG,CAAC;AAC5E,UAAM,YAAY,SAAS,OAAO,QAAQ,OAAO,WAAW,KAAK,GAAG;AACpE,UAAM,gBAAgB,SAAS,MAAM,UAAU,KAAK;;;;;AA5E7C,YAAA,OAAAM,eAAAC,WAAA,EAAA,OAAM,kBAAA,GAAiB,MAAA,CAAA,CAAA,wHAKnBF,eAAAL,MAAA,OAAA,GAAS,YAAYA,MAAA,IAAA,GAAM,KAAK,CAAA,aAAA;AAK5B,UAAAA,MAAA,OAAA,GAAO;0SAIsCA,MAAA,KAAA,CAAK,CAAA,0KAAAK,eAILL,MAAA,OAAA,EAAQ,QAAQ,eAAA,CAAc,CAAA,yKAAAG,eAAA,EAAA,OAAA,GAO5DH,MAAA,aAAA,CAAa,IAAA,CAAA,CAAA,uEAAAK,eAIhCL,MAAA,SAAA,CAAS,CAAA,wBAAAK,eAA2BL,MAAA,KAAA,IAAK,CAAA,CAAA,YAAA;AAAA;;;;;QAa5C,IAAG;AAAA,QACH,OAAM;AAAA,MAAA,GAAA;AAAA,yBAFR,CAKW,GAAAD,QAAAS,UAAA,aAAA;;;;;8BAFV,kBAED;AAAA,YAAA;AAAA;;;;;QAEE,IAAG;AAAA,QACH,OAAM;AAAA,MAAA,GAAA;AAAA,yBAFR,CAKW,GAAAT,QAAAS,UAAA,aAAA;;;;;8BAFV,iBAED;AAAA,YAAA;AAAA;;;;;AAKM,UAAAR,MAAA,cAAA,GAAc;;UACnB,SAAA,CAAA,WAAO,eAAA,QAAc;AAAA,UACrB,WAAA,CAAA,WAAS,eAAA,QAAc;AAAA,QAAA,GAAA,MAAA,OAAA,CAAA;AAAA;;;;;;;;;;;;;;","names":["_ssrRenderTeleport","_push","_unref","_ssrRenderClass","_ssrRenderList","_ssrRenderStyle","_ssrIncludeBooleanAttr","_ssrInterpolate","_ssrRenderAttrs","_mergeProps","_parent"],"sources":["../../../../../../../app/components/workout/StartWorkoutModal.vue","../../../../../../../app/pages/train/index.vue"],"sourcesContent":["<template>\n  <Teleport to=\"body\">\n    <div\n      class=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center\"\n      @click.self=\"$emit('close')\"\n    >\n      <div class=\"fixed inset-0 bg-black/60\" @click=\"$emit('close')\" />\n\n      <div\n        class=\"relative w-full sm:max-w-sm bg-forge-bg border border-forge-divider rounded-t-2xl sm:rounded-2xl px-5 py-6 animate-scale-in\"\n      >\n        <h2 class=\"font-bold text-lg mb-5\">Nuevo entrenamiento</h2>\n\n        <!-- Name -->\n        <div class=\"mb-5\">\n          <label class=\"block text-forge-textSec text-sm font-medium mb-2\">Nombre</label>\n          <input\n            v-model=\"name\"\n            type=\"text\"\n            maxlength=\"50\"\n            placeholder=\"Ej: Push Day, Full Body...\"\n            autofocus\n            class=\"w-full bg-forge-surface border border-forge-divider rounded-xl px-4 py-3 text-forge-text placeholder-forge-muted focus:outline-none focus:border-forge-primary transition-colors\"\n            :class=\"{ 'border-red-500': nameError }\"\n            @keydown.enter=\"start\"\n          />\n          <p v-if=\"nameError\" class=\"text-red-400 text-xs mt-1.5\">{{ nameError }}</p>\n        </div>\n\n        <!-- Color -->\n        <div class=\"mb-6\">\n          <label class=\"block text-forge-textSec text-sm font-medium mb-3\">Color</label>\n          <div class=\"flex gap-3 flex-wrap\">\n            <button\n              v-for=\"color in TEMPLATE_COLORS\"\n              :key=\"color\"\n              @click=\"selectedColor = color\"\n              class=\"w-9 h-9 rounded-full transition-transform duration-150 flex items-center justify-center\"\n              :style=\"{ background: argbToHex(color) }\"\n              :class=\"selectedColor === color ? 'scale-110 ring-2 ring-white/60' : 'hover:scale-105'\"\n            >\n              <Check v-if=\"selectedColor === color\" :size=\"14\" class=\"text-white drop-shadow\" />\n            </button>\n          </div>\n        </div>\n\n        <!-- Actions -->\n        <div class=\"flex gap-3\">\n          <button\n            @click=\"$emit('close')\"\n            class=\"flex-1 py-3 rounded-xl border border-forge-divider text-forge-text font-medium hover:bg-forge-surface transition-colors text-sm\"\n          >\n            Cancelar\n          </button>\n          <button\n            @click=\"start\"\n            :disabled=\"isStarting\"\n            class=\"flex-1 py-3 rounded-xl gradient-orange text-white font-bold disabled:opacity-60 flex items-center justify-center gap-2 text-sm glow-orange-hover transition-all\"\n          >\n            <Loader2 v-if=\"isStarting\" :size=\"16\" class=\"animate-spin\" />\n            {{ isStarting ? 'Iniciando...' : 'Empezar' }}\n          </button>\n        </div>\n      </div>\n    </div>\n  </Teleport>\n</template>\n\n<script setup lang=\"ts\">\nimport { Check, Loader2 } from 'lucide-vue-next'\nimport { storeToRefs } from 'pinia'\nimport { TEMPLATE_COLORS, argbToHex } from '~/utils/colors'\nimport { workoutService } from '~/services/workout.service'\n\nconst emit = defineEmits<{ close: []; started: [] }>()\n\nconst { user } = storeToRefs(useAuthStore())\nconst workoutStore = useActiveWorkoutStore()\n\nconst name = ref('')\nconst selectedColor = ref<number>(TEMPLATE_COLORS[0])\nconst nameError = ref('')\nconst isStarting = ref(false)\n\nasync function start() {\n  nameError.value = ''\n  if (!name.value.trim()) {\n    nameError.value = 'El nombre es requerido'\n    return\n  }\n\n  isStarting.value = true\n  try {\n    const workoutId = await workoutService.createWorkout({\n      userId: user.value!.id,\n      name: name.value.trim(),\n      color: selectedColor.value,\n    })\n\n    workoutStore.initWorkout({\n      workoutId,\n      name: name.value.trim(),\n      color: selectedColor.value,\n      exercises: [],\n    })\n\n    emit('started')\n    await navigateTo('/train/workout/active')\n  } catch {\n    nameError.value = 'Error al iniciar. Inténtalo de nuevo'\n  } finally {\n    isStarting.value = false\n  }\n}\n</script>\n","<template>\n  <div class=\"animate-fade-in\">\n    <!-- Greeting -->\n    <div class=\"mb-8\">\n      <p class=\"text-forge-muted text-sm\">Bienvenido de vuelta</p>\n      <h1 class=\"text-2xl font-bold mt-0.5\">\n        {{ profile?.nickname ?? user?.email }}\n      </h1>\n    </div>\n\n    <!-- XP / Level card -->\n    <div v-if=\"profile\" class=\"bg-forge-surface border border-forge-divider rounded-2xl p-4 mb-6\">\n      <div class=\"flex items-center justify-between mb-3\">\n        <div>\n          <p class=\"text-forge-muted text-xs uppercase tracking-widest font-medium\">Nivel</p>\n          <p class=\"text-3xl font-black text-forge-text\">{{ level }}</p>\n        </div>\n        <div class=\"text-right\">\n          <p class=\"text-forge-muted text-xs uppercase tracking-widest font-medium\">XP Total</p>\n          <p class=\"text-lg font-bold text-forge-accent\">{{ profile.totalXp.toLocaleString() }}</p>\n        </div>\n      </div>\n      <!-- XP progress bar -->\n      <div class=\"h-2 bg-forge-surfaceAlt rounded-full overflow-hidden\">\n        <div\n          class=\"h-full gradient-orange rounded-full transition-all duration-700\"\n          :style=\"{ width: `${xpProgressPct}%` }\"\n        />\n      </div>\n      <p class=\"text-forge-muted text-xs mt-1.5 text-right\">\n        {{ xpInLevel }} / 100 XP para nivel {{ level + 1 }}\n      </p>\n    </div>\n\n    <!-- Quick actions -->\n    <div class=\"space-y-3\">\n      <button\n        @click=\"showStartModal = true\"\n        class=\"w-full gradient-orange text-white font-bold py-4 rounded-2xl text-base glow-orange-hover transition-all active:scale-[0.98]\"\n      >\n        Iniciar entrenamiento\n      </button>\n      <NuxtLink\n        to=\"/train/templates\"\n        class=\"w-full bg-forge-surface text-forge-text font-semibold py-4 rounded-2xl border border-forge-divider hover:border-forge-primary/40 transition-colors active:scale-[0.98] flex items-center justify-center\"\n      >\n        Ver plantillas\n      </NuxtLink>\n      <NuxtLink\n        to=\"/train/workout/history\"\n        class=\"w-full bg-forge-surface text-forge-muted font-medium py-3 rounded-2xl border border-forge-divider hover:border-forge-primary/40 transition-colors active:scale-[0.98] flex items-center justify-center text-sm\"\n      >\n        Ver historial\n      </NuxtLink>\n    </div>\n\n    <!-- Start workout modal -->\n    <WorkoutStartWorkoutModal\n      v-if=\"showStartModal\"\n      @close=\"showStartModal = false\"\n      @started=\"showStartModal = false\"\n    />\n\n    <SharedToastContainer />\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { storeToRefs } from 'pinia'\n\ndefinePageMeta({ layout: 'train', middleware: 'auth' })\n\nconst { user, profile } = storeToRefs(useAuthStore())\nconst showStartModal = ref(false)\n\nconst level = computed(() => Math.floor((profile.value?.totalXp ?? 0) / 100))\nconst xpInLevel = computed(() => (profile.value?.totalXp ?? 0) % 100)\nconst xpProgressPct = computed(() => xpInLevel.value)\n</script>\n"],"version":3}