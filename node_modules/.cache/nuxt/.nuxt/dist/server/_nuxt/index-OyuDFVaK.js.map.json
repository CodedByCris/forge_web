KZ,YAAAK,mBAAA,wBAAA,EAAA,aAAY,aAAS,MAAA,OAAA,CAAA;;;AAGrB,YAAAA,mBAAA,wBAAA,EAAA,aAAY,aAAS,MAAA,OAAA,CAAA;;;QAEvB,MAAMC,MAAA,SAAA;AAAA,QAAY,SAAO;AAAA,MAAA,GAAA,MAAA,OAAA,CAAA;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderStyle","_ssrRenderClass","_ssrInterpolate","_ssrRenderTeleport","_push","_ssrRenderComponent","_unref"],"sources":["../../../../../../../app/components/HeroSection.vue","../../../../../../../app/components/FeaturesSection.vue","../../../../../../../app/components/HowItWorks.vue","../../../../../../../app/components/BetaSection.vue","../../../../../../../app/components/AppFooter.vue","../../../../../../../app/components/BetaModal.vue","../../../../../../../app/pages/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\ndefineEmits<{ 'open-modal': [] }>()\n</script>\n\n<template>\n  <section\n    class=\"relative min-h-screen flex items-center justify-center overflow-hidden px-4 pt-16 pb-24\"\n  >\n    <!-- Ambient background glow -->\n    <div\n      class=\"absolute inset-0 pointer-events-none\"\n      aria-hidden=\"true\"\n    >\n      <div\n        class=\"absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full opacity-10\"\n        style=\"background: radial-gradient(circle, #FF6200 0%, transparent 70%)\"\n      />\n    </div>\n\n    <div class=\"relative z-10 max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center w-full\">\n      <!-- Left: copy -->\n      <div class=\"text-center lg:text-left animate-fade-in-up\">\n        <!-- Badge -->\n        <span\n          class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest mb-6\"\n          style=\"background: rgba(255,98,0,0.15); border: 1px solid rgba(255,98,0,0.3); color: #FF9A3C\"\n        >\n          <span class=\"w-1.5 h-1.5 rounded-full bg-forge-accent animate-pulse\" />\n          Beta disponible en Android\n        </span>\n\n        <!-- Headline -->\n        <h1 class=\"text-5xl sm:text-6xl lg:text-7xl font-black leading-[1.05] tracking-tight mb-6\">\n          Forja<br />\n          <span class=\"text-gradient-orange\">tus límites.</span>\n        </h1>\n\n        <!-- Subheading -->\n        <p class=\"text-forge-textSec text-lg sm:text-xl leading-relaxed mb-10 max-w-lg mx-auto lg:mx-0\">\n          Registra entrenamientos, visualiza tu progreso, compite con amigos en tiempo real y sube de nivel con gamificación integrada.\n        </p>\n\n        <!-- CTA -->\n        <div class=\"flex flex-col sm:flex-row gap-4 justify-center lg:justify-start\">\n          <button\n            @click=\"$emit('open-modal')\"\n            class=\"inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl text-white font-bold text-base gradient-orange glow-orange glow-orange-hover transition-all duration-200 hover:scale-105 active:scale-95\"\n          >\n            <!-- Android icon -->\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n              <path d=\"M6.18 15.64a2.18 2.18 0 0 1-2.18-2.18V9.5a2.18 2.18 0 0 1 4.36 0v3.96a2.18 2.18 0 0 1-2.18 2.18zm11.64 0a2.18 2.18 0 0 1-2.18-2.18V9.5a2.18 2.18 0 0 1 4.36 0v3.96a2.18 2.18 0 0 1-2.18 2.18zM3.56 8.04C3.56 5.38 7.44 3 12 3s8.44 2.38 8.44 5.04v8.6c0 .7-.57 1.27-1.27 1.27h-.5v2.27a1.82 1.82 0 0 1-3.64 0V16.9H8.97v2.27a1.82 1.82 0 0 1-3.64 0V16.9h-.5c-.7 0-1.27-.57-1.27-1.27v-8.6zM8.71 2.27l-1-1.73a.27.27 0 0 0-.47.27L8.3 2.6a6.18 6.18 0 0 1 3.7-.6 6.18 6.18 0 0 1 3.7.6l1.06-1.79a.27.27 0 0 0-.47-.27l-1 1.73A6.25 6.25 0 0 0 12 2c-1.18 0-2.28.1-3.29.27zM9.5 6.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1zm5 0a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z\"/>\n            </svg>\n            Descargar en Android\n          </button>\n          <span class=\"self-center text-forge-muted text-sm\">iOS próximamente</span>\n        </div>\n      </div>\n\n      <!-- Right: phone mockup -->\n      <div class=\"flex justify-center lg:justify-end animate-fade-in-up\" style=\"animation-delay: 0.2s\">\n        <div class=\"relative\">\n          <!-- Glow behind phone -->\n          <div\n            class=\"absolute inset-0 rounded-[3rem] blur-3xl opacity-30 -z-10 scale-90\"\n            style=\"background: linear-gradient(135deg, #FF6200, #FF9A3C)\"\n          />\n\n          <!-- Phone frame -->\n          <div\n            class=\"relative w-[240px] sm:w-[280px] h-[480px] sm:h-[560px] rounded-[3rem] border-2 border-forge-divider overflow-hidden\"\n            style=\"background: #1A1A1A; box-shadow: 0 32px 64px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.05)\"\n          >\n            <!-- Notch -->\n            <div class=\"absolute top-4 left-1/2 -translate-x-1/2 w-20 h-5 rounded-full bg-forge-bg z-10\" />\n\n            <!-- Screen content (fake UI) -->\n            <div class=\"absolute inset-0 pt-14 px-4 pb-6 flex flex-col gap-3\">\n              <!-- Header row -->\n              <div class=\"flex items-center justify-between\">\n                <div>\n                  <p class=\"text-forge-muted text-xs\">Hola,</p>\n                  <p class=\"text-forge-text text-sm font-bold\">Criss 🔥</p>\n                </div>\n                <div class=\"w-8 h-8 rounded-full gradient-orange flex items-center justify-center text-xs font-black text-white\">\n                  12\n                </div>\n              </div>\n\n              <!-- XP bar -->\n              <div class=\"rounded-xl p-3\" style=\"background: #242424; border: 1px solid #2A2A2A\">\n                <div class=\"flex justify-between text-xs mb-1.5\">\n                  <span class=\"text-forge-muted\">XP</span>\n                  <span style=\"color: #8B5CF6\">1240 / 2000</span>\n                </div>\n                <div class=\"w-full h-1.5 rounded-full\" style=\"background: #2A2A2A\">\n                  <div class=\"h-full rounded-full\" style=\"width: 62%; background: linear-gradient(90deg, #8B5CF6, #a78bfa)\" />\n                </div>\n              </div>\n\n              <!-- Workout card -->\n              <div class=\"rounded-xl p-3\" style=\"background: #242424; border: 1px solid #2A2A2A\">\n                <p class=\"text-forge-muted text-xs mb-2\">Último entreno</p>\n                <p class=\"text-forge-text text-sm font-bold mb-3\">Push A — Pecho</p>\n                <div class=\"flex gap-2\">\n                  <div class=\"flex-1 text-center rounded-lg py-2\" style=\"background: rgba(255,98,0,0.1)\">\n                    <p class=\"text-forge-primary font-black text-sm\">4</p>\n                    <p class=\"text-forge-muted text-xs\">series</p>\n                  </div>\n                  <div class=\"flex-1 text-center rounded-lg py-2\" style=\"background: rgba(255,98,0,0.1)\">\n                    <p class=\"text-forge-primary font-black text-sm\">80kg</p>\n                    <p class=\"text-forge-muted text-xs\">peso</p>\n                  </div>\n                  <div class=\"flex-1 text-center rounded-lg py-2\" style=\"background: rgba(16,185,129,0.1)\">\n                    <p class=\"text-forge-success font-black text-sm\">+5%</p>\n                    <p class=\"text-forge-muted text-xs\">mejora</p>\n                  </div>\n                </div>\n              </div>\n\n              <!-- Ranked card -->\n              <div\n                class=\"rounded-xl p-3 flex items-center gap-3\"\n                style=\"background: linear-gradient(135deg, rgba(255,98,0,0.2), rgba(255,154,60,0.1)); border: 1px solid rgba(255,98,0,0.3)\"\n              >\n                <div class=\"text-2xl\">⚔️</div>\n                <div>\n                  <p class=\"text-forge-accent text-xs font-bold uppercase tracking-wider\">Modo Ranked</p>\n                  <p class=\"text-forge-text text-xs\">vs. Adrián — en curso</p>\n                </div>\n              </div>\n\n              <!-- Bottom nav bar -->\n              <div\n                class=\"mt-auto flex justify-around items-center py-2 rounded-2xl\"\n                style=\"background: #242424; border: 1px solid #2A2A2A\"\n              >\n                <div class=\"flex flex-col items-center gap-0.5\">\n                  <div class=\"w-4 h-4 rounded\" style=\"background: #FF6200\" />\n                  <span class=\"text-forge-primary text-xs\">Inicio</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-0.5\">\n                  <div class=\"w-4 h-4 rounded\" style=\"background: #2A2A2A\" />\n                  <span class=\"text-forge-muted text-xs\">Stats</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-0.5\">\n                  <div class=\"w-4 h-4 rounded\" style=\"background: #2A2A2A\" />\n                  <span class=\"text-forge-muted text-xs\">Social</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-0.5\">\n                  <div class=\"w-4 h-4 rounded\" style=\"background: #2A2A2A\" />\n                  <span class=\"text-forge-muted text-xs\">Perfil</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Scroll indicator -->\n    <div class=\"absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce\">\n      <span class=\"text-forge-muted text-xs tracking-widest uppercase\">Descubrir</span>\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#666\" stroke-width=\"2\" stroke-linecap=\"round\">\n        <polyline points=\"6 9 12 15 18 9\"/>\n      </svg>\n    </div>\n  </section>\n</template>\n","<script setup lang=\"ts\">\nconst features = [\n  {\n    title: 'Seguimiento de entrenos',\n    desc: 'Registra pesos, series y reps con una interfaz rápida y sin fricción.',\n    icon: 'dumbbell',\n    color: '#FF6200',\n    delay: 0,\n  },\n  {\n    title: 'Estadísticas y progreso',\n    desc: 'Gráficas claras de tu evolución por ejercicio, semana y mes.',\n    icon: 'chart',\n    color: '#FF9A3C',\n    delay: 1,\n  },\n  {\n    title: 'Feed social',\n    desc: 'Comparte tus entrenos con amigos y reacciona a sus logros.',\n    icon: 'users',\n    color: '#FF6200',\n    delay: 2,\n  },\n  {\n    title: 'Modo Ranked',\n    desc: 'Compite en tiempo real con un amigo. El mejor entreno gana.',\n    icon: 'ranked',\n    color: '#FF9A3C',\n    delay: 3,\n  },\n  {\n    title: 'Rutinas con IA',\n    desc: 'Genera tu plan personalizado en segundos según tus objetivos.',\n    icon: 'ai',\n    color: '#8B5CF6',\n    delay: 4,\n  },\n  {\n    title: 'Gamificación',\n    desc: 'XP, niveles, badges y rachas. Cada entreno te hace más fuerte.',\n    icon: 'xp',\n    color: '#8B5CF6',\n    delay: 5,\n  },\n]\n\nonMounted(() => {\n  const els = document.querySelectorAll('.reveal')\n  const io = new IntersectionObserver(\n    (entries) => {\n      entries.forEach((e) => {\n        if (e.isIntersecting) {\n          e.target.classList.add('visible')\n          io.unobserve(e.target)\n        }\n      })\n    },\n    { threshold: 0.12 }\n  )\n  els.forEach((el) => io.observe(el))\n})\n</script>\n\n<template>\n  <section class=\"py-24 px-4\" style=\"background: #0F0F0F\">\n    <div class=\"max-w-6xl mx-auto\">\n      <!-- Header -->\n      <div class=\"text-center mb-16 reveal\">\n        <p class=\"text-forge-primary text-sm font-semibold uppercase tracking-widest mb-3\">Funcionalidades</p>\n        <h2 class=\"text-4xl sm:text-5xl font-black tracking-tight\">\n          Todo lo que necesitas<br />\n          <span class=\"text-gradient-orange\">para entrenar mejor.</span>\n        </h2>\n      </div>\n\n      <!-- Grid -->\n      <div class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n        <div\n          v-for=\"(feat, i) in features\"\n          :key=\"feat.title\"\n          :class=\"`reveal reveal-delay-${feat.delay}`\"\n        >\n          <div\n            class=\"group h-full rounded-2xl p-6 border border-forge-divider transition-all duration-200 hover:scale-[1.03] hover:border-forge-primary cursor-default\"\n            style=\"background: #1A1A1A\"\n          >\n            <!-- Icon -->\n            <div\n              class=\"w-12 h-12 rounded-xl flex items-center justify-center mb-5 transition-all duration-200 group-hover:scale-110\"\n              :style=\"`background: ${feat.color}1A; border: 1px solid ${feat.color}40`\"\n            >\n              <!-- Dumbbell -->\n              <template v-if=\"feat.icon === 'dumbbell'\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" :stroke=\"feat.color\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M6.5 6.5h.01M17.5 6.5h.01M6 17.5h.01M17 17.5h.01\"/>\n                  <path d=\"M8 8H3.5A1.5 1.5 0 0 0 2 9.5v5A1.5 1.5 0 0 0 3.5 16H8M16 8h4.5A1.5 1.5 0 0 1 22 9.5v5a1.5 1.5 0 0 1-1.5 1.5H16\"/>\n                  <rect x=\"8\" y=\"6\" width=\"8\" height=\"12\" rx=\"1\"/>\n                </svg>\n              </template>\n\n              <!-- Chart -->\n              <template v-else-if=\"feat.icon === 'chart'\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" :stroke=\"feat.color\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/>\n                </svg>\n              </template>\n\n              <!-- Users -->\n              <template v-else-if=\"feat.icon === 'users'\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" :stroke=\"feat.color\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/>\n                  <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n                  <path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/>\n                  <path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/>\n                </svg>\n              </template>\n\n              <!-- Ranked (sword) -->\n              <template v-else-if=\"feat.icon === 'ranked'\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" :stroke=\"feat.color\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <polyline points=\"14.5 17.5 3 6 3 3 6 3 17.5 14.5\"/>\n                  <line x1=\"13\" y1=\"19\" x2=\"19\" y2=\"13\"/>\n                  <line x1=\"16\" y1=\"16\" x2=\"20\" y2=\"20\"/>\n                  <line x1=\"19\" y1=\"21\" x2=\"21\" y2=\"19\"/>\n                </svg>\n              </template>\n\n              <!-- AI (sparkles) -->\n              <template v-else-if=\"feat.icon === 'ai'\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" :stroke=\"feat.color\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z\"/>\n                  <path d=\"M19 15l.75 2.25L22 18l-2.25.75L19 21l-.75-2.25L16 18l2.25-.75L19 15z\"/>\n                  <path d=\"M5 3l.5 1.5L7 5l-1.5.5L5 7l-.5-1.5L3 5l1.5-.5L5 3z\"/>\n                </svg>\n              </template>\n\n              <!-- XP (star/trophy) -->\n              <template v-else-if=\"feat.icon === 'xp'\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" :stroke=\"feat.color\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/>\n                </svg>\n              </template>\n            </div>\n\n            <h3 class=\"text-forge-text font-bold text-lg mb-2 group-hover:text-forge-accent transition-colors duration-200\">\n              {{ feat.title }}\n            </h3>\n            <p class=\"text-forge-muted text-sm leading-relaxed\">{{ feat.desc }}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n","<script setup lang=\"ts\">\nconst steps = [\n  {\n    number: '01',\n    title: 'Registra',\n    desc: 'Añade tus ejercicios, series y pesos en segundos. Historial completo siempre a mano.',\n  },\n  {\n    number: '02',\n    title: 'Progresa',\n    desc: 'Visualiza tu evolución con estadísticas detalladas. Ve cuánto has mejorado semana a semana.',\n  },\n  {\n    number: '03',\n    title: 'Compite',\n    desc: 'Reta a tus amigos en Modo Ranked y sube de nivel ganando XP con cada entreno.',\n  },\n]\n</script>\n\n<template>\n  <section class=\"py-24 px-4\" style=\"background: #0F0F0F; border-top: 1px solid #2A2A2A\">\n    <div class=\"max-w-5xl mx-auto\">\n      <!-- Header -->\n      <div class=\"text-center mb-16 reveal\">\n        <p class=\"text-forge-primary text-sm font-semibold uppercase tracking-widest mb-3\">Cómo funciona</p>\n        <h2 class=\"text-4xl sm:text-5xl font-black tracking-tight\">\n          Simple. <span class=\"text-gradient-orange\">Potente.</span>\n        </h2>\n      </div>\n\n      <!-- Steps -->\n      <div class=\"relative flex flex-col lg:flex-row gap-0 lg:gap-0\">\n        <!-- Connector line (desktop) -->\n        <div\n          class=\"hidden lg:block absolute top-10 left-[calc(16.67%+1.5rem)] right-[calc(16.67%+1.5rem)] h-px\"\n          style=\"background: linear-gradient(90deg, transparent, #FF6200, #FF9A3C, #FF6200, transparent)\"\n          aria-hidden=\"true\"\n        />\n\n        <div\n          v-for=\"(step, i) in steps\"\n          :key=\"step.number\"\n          :class=\"`reveal reveal-delay-${i + 1} flex-1 flex flex-col lg:items-center text-left lg:text-center`\"\n        >\n          <!-- Number circle + connector (mobile) -->\n          <div class=\"flex lg:flex-col items-start lg:items-center gap-5 lg:gap-0\">\n            <div class=\"flex flex-col lg:flex-row items-center\">\n              <!-- Vertical connector (mobile) -->\n              <div v-if=\"i < steps.length - 1\" class=\"lg:hidden w-px flex-1 min-h-[2rem] ml-[1.5rem]\" style=\"background: linear-gradient(180deg, #FF6200, transparent)\" />\n            </div>\n\n            <div class=\"flex items-start gap-5 lg:flex-col lg:items-center lg:gap-0 w-full pb-10 lg:pb-0\">\n              <!-- Number badge -->\n              <div\n                class=\"relative z-10 flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center font-black text-sm lg:mb-8\"\n                style=\"background: linear-gradient(135deg, #FF6200, #FF9A3C); box-shadow: 0 0 24px rgba(255,98,0,0.4)\"\n              >\n                {{ step.number }}\n              </div>\n\n              <!-- Text -->\n              <div class=\"lg:px-6 lg:mt-0\">\n                <h3 class=\"text-2xl font-black text-forge-text mb-2\">{{ step.title }}</h3>\n                <p class=\"text-forge-muted text-sm leading-relaxed max-w-xs\">{{ step.desc }}</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n","<script setup lang=\"ts\">\ndefineEmits<{ 'open-modal': [] }>()\n</script>\n\n<template>\n  <section class=\"py-28 px-4 relative overflow-hidden\" style=\"background: #0F0F0F; border-top: 1px solid #2A2A2A\">\n    <!-- Background glow -->\n    <div\n      class=\"absolute inset-0 pointer-events-none\"\n      aria-hidden=\"true\"\n    >\n      <div\n        class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] rounded-full opacity-[0.07]\"\n        style=\"background: radial-gradient(ellipse, #FF6200 0%, transparent 70%)\"\n      />\n    </div>\n\n    <div class=\"relative z-10 max-w-3xl mx-auto text-center reveal\">\n      <!-- Eyebrow -->\n      <span\n        class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest mb-8\"\n        style=\"background: rgba(255,98,0,0.12); border: 1px solid rgba(255,98,0,0.3); color: #FF9A3C\"\n      >\n        <span class=\"w-1.5 h-1.5 rounded-full bg-forge-accent animate-pulse\" />\n        Beta abierta\n      </span>\n\n      <h2 class=\"text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight mb-6\">\n        Únete a la beta<br />\n        <span class=\"text-gradient-orange\">de Forge.</span>\n      </h2>\n\n      <p class=\"text-forge-textSec text-lg mb-10\">\n        Disponible ahora en Android. iOS próximamente.\n      </p>\n\n      <button\n        @click=\"$emit('open-modal')\"\n        class=\"inline-flex items-center justify-center gap-3 px-10 py-5 rounded-2xl text-white font-bold text-lg gradient-orange glow-orange glow-orange-hover transition-all duration-200 hover:scale-105 active:scale-95\"\n      >\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path d=\"M6.18 15.64a2.18 2.18 0 0 1-2.18-2.18V9.5a2.18 2.18 0 0 1 4.36 0v3.96a2.18 2.18 0 0 1-2.18 2.18zm11.64 0a2.18 2.18 0 0 1-2.18-2.18V9.5a2.18 2.18 0 0 1 4.36 0v3.96a2.18 2.18 0 0 1-2.18 2.18zM3.56 8.04C3.56 5.38 7.44 3 12 3s8.44 2.38 8.44 5.04v8.6c0 .7-.57 1.27-1.27 1.27h-.5v2.27a1.82 1.82 0 0 1-3.64 0V16.9H8.97v2.27a1.82 1.82 0 0 1-3.64 0V16.9h-.5c-.7 0-1.27-.57-1.27-1.27v-8.6zM8.71 2.27l-1-1.73a.27.27 0 0 0-.47.27L8.3 2.6a6.18 6.18 0 0 1 3.7-.6 6.18 6.18 0 0 1 3.7.6l1.06-1.79a.27.27 0 0 0-.47-.27l-1 1.73A6.25 6.25 0 0 0 12 2c-1.18 0-2.28.1-3.29.27zM9.5 6.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1zm5 0a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z\"/>\n        </svg>\n        Descargar en Android\n      </button>\n\n      <p class=\"mt-5 text-forge-muted text-sm\">Gratis · Sin tarjeta de crédito</p>\n    </div>\n  </section>\n</template>\n","<template>\n  <footer class=\"py-12 px-4\" style=\"background: #0F0F0F; border-top: 1px solid #2A2A2A\">\n    <div class=\"max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6\">\n      <!-- Brand -->\n      <div class=\"flex flex-col items-center sm:items-start gap-1\">\n        <span class=\"text-2xl font-black text-gradient-orange\">Forge</span>\n        <span class=\"text-forge-muted text-xs\">Entrena. Progresa. Compite.</span>\n      </div>\n\n      <!-- Right -->\n      <div class=\"flex flex-col items-center sm:items-end gap-1\">\n        <p class=\"text-forge-muted text-xs\">© 2025 Forge by Criss</p>\n        <p class=\"text-forge-muted text-xs\">Hecho con ❤️ para los que no se rinden</p>\n      </div>\n    </div>\n  </footer>\n</template>\n","<script setup lang=\"ts\">\nconst props = defineProps<{ open: boolean }>()\ndefineEmits<{ close: [] }>()\n\n// Trap focus when modal opens — minimal, no library\nconst modalRef = ref<HTMLDivElement | null>(null)\n\nwatch(\n  () => props.open,\n  (val) => {\n    nextTick(() => {\n      if (val && modalRef.value) {\n        const focusable = modalRef.value.querySelectorAll<HTMLElement>(\n          'button, [href], input, [tabindex]:not([tabindex=\"-1\"])'\n        )\n        focusable[0]?.focus()\n      }\n    })\n  }\n)\n</script>\n\n<template>\n  <Teleport to=\"body\">\n    <Transition\n      enter-active-class=\"transition-opacity duration-200\"\n      enter-from-class=\"opacity-0\"\n      enter-to-class=\"opacity-100\"\n      leave-active-class=\"transition-opacity duration-200\"\n      leave-from-class=\"opacity-100\"\n      leave-to-class=\"opacity-0\"\n    >\n      <div\n        v-if=\"open\"\n        class=\"fixed inset-0 z-50 flex items-center justify-center p-4\"\n        style=\"background: rgba(0,0,0,0.82)\"\n        @click.self=\"$emit('close')\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"modal-title\"\n      >\n        <Transition\n          enter-active-class=\"transition-all duration-200\"\n          enter-from-class=\"opacity-0 scale-95\"\n          enter-to-class=\"opacity-100 scale-100\"\n          leave-active-class=\"transition-all duration-150\"\n          leave-from-class=\"opacity-100 scale-100\"\n          leave-to-class=\"opacity-0 scale-95\"\n          appear\n        >\n          <div\n            v-if=\"open\"\n            ref=\"modalRef\"\n            class=\"relative w-full max-w-md rounded-3xl p-8 border border-forge-divider\"\n            style=\"background: #1A1A1A; box-shadow: 0 32px 80px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,98,0,0.08)\"\n          >\n            <!-- Close button -->\n            <button\n              @click=\"$emit('close')\"\n              class=\"absolute top-5 right-5 w-8 h-8 rounded-full flex items-center justify-center text-forge-muted hover:text-forge-text hover:bg-forge-surfaceAlt transition-all duration-150\"\n              aria-label=\"Cerrar\"\n            >\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n                <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/>\n                <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/>\n              </svg>\n            </button>\n\n            <!-- Icon -->\n            <div\n              class=\"w-14 h-14 rounded-2xl flex items-center justify-center mb-6\"\n              style=\"background: rgba(255,98,0,0.15); border: 1px solid rgba(255,98,0,0.3)\"\n            >\n              <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"#FF6200\" aria-hidden=\"true\">\n                <path d=\"M6.18 15.64a2.18 2.18 0 0 1-2.18-2.18V9.5a2.18 2.18 0 0 1 4.36 0v3.96a2.18 2.18 0 0 1-2.18 2.18zm11.64 0a2.18 2.18 0 0 1-2.18-2.18V9.5a2.18 2.18 0 0 1 4.36 0v3.96a2.18 2.18 0 0 1-2.18 2.18zM3.56 8.04C3.56 5.38 7.44 3 12 3s8.44 2.38 8.44 5.04v8.6c0 .7-.57 1.27-1.27 1.27h-.5v2.27a1.82 1.82 0 0 1-3.64 0V16.9H8.97v2.27a1.82 1.82 0 0 1-3.64 0V16.9h-.5c-.7 0-1.27-.57-1.27-1.27v-8.6zM8.71 2.27l-1-1.73a.27.27 0 0 0-.47.27L8.3 2.6a6.18 6.18 0 0 1 3.7-.6 6.18 6.18 0 0 1 3.7.6l1.06-1.79a.27.27 0 0 0-.47-.27l-1 1.73A6.25 6.25 0 0 0 12 2c-1.18 0-2.28.1-3.29.27zM9.5 6.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1zm5 0a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z\"/>\n              </svg>\n            </div>\n\n            <!-- Title -->\n            <h2 id=\"modal-title\" class=\"text-2xl font-black text-forge-text mb-3\">\n              Forge está en fase beta\n            </h2>\n\n            <!-- Body -->\n            <p class=\"text-forge-textSec text-sm leading-relaxed mb-8\">\n              Para unirte como tester, únete al grupo de Google con tu cuenta de Gmail.\n              Una vez dentro, recibirás acceso automático a la app desde Play Store.\n            </p>\n\n            <!-- Divider -->\n            <div class=\"h-px mb-8\" style=\"background: #2A2A2A\" />\n\n            <!-- CTA -->\n            <a\n              href=\"https://groups.google.com/g/android-testers-cris\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              class=\"flex items-center justify-center gap-3 w-full py-4 rounded-2xl text-white font-bold text-base gradient-orange glow-orange glow-orange-hover transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]\"\n            >\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n                <path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/>\n                <polyline points=\"15 3 21 3 21 9\"/>\n                <line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/>\n              </svg>\n              Unirme al grupo de testers\n            </a>\n\n            <!-- Note -->\n            <p class=\"text-center text-forge-muted text-xs mt-4\">\n              Necesitas estar logado con tu cuenta de Google/Gmail\n            </p>\n          </div>\n        </Transition>\n      </div>\n    </Transition>\n  </Teleport>\n</template>\n","<script setup lang=\"ts\">\nconst showModal = ref(false)\n\nfunction openModal() {\n  showModal.value = true\n  document.body.style.overflow = 'hidden'\n}\n\nfunction closeModal() {\n  showModal.value = false\n  document.body.style.overflow = ''\n}\n\n// Close on Escape key\nonMounted(() => {\n  window.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') closeModal()\n  })\n})\n\nonUnmounted(() => {\n  document.body.style.overflow = ''\n})\n\nprovide('openModal', openModal)\n</script>\n\n<template>\n  <main>\n    <HeroSection @open-modal=\"openModal\" />\n    <FeaturesSection />\n    <HowItWorks />\n    <BetaSection @open-modal=\"openModal\" />\n    <AppFooter />\n    <BetaModal :open=\"showModal\" @close=\"closeModal\" />\n  </main>\n</template>\n"],"version":3}